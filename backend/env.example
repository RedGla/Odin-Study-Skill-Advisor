# Environment Configuration
# Copy to .env and update values for your deployment

# Application Environment: development or production
ENVIRONMENT=development

# Frontend URL (where your React app is hosted)
# Local: http://localhost:5173
# Production: https://your-vercel-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Cookie Security Settings
# For DEVELOPMENT (localhost): secure=false, samesite=lax
# For PRODUCTION (HTTPS cross-origin): secure=true, samesite=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Database URL (PostgreSQL/Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/advisor_db

# OpenRouter (LLM provider) — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Any model slug OpenRouter supports, e.g. openai/gpt-4o-mini, anthropic/claude-3.5-haiku
OPENROUTER_MODEL=openai/gpt-4o-mini
# Used only for OpenRouter's attribution headers — not secret
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=Advisor Console

# Google Docs advisor context (service account must have access to both docs)
# The code reads GOOGLE_SYSTEM_PROMPT_DOCUMENT_ID and GOOGLE_GROUNDING_DOCUMENT_ID
# (it also accepts the legacy GOOGLE_DOCS_PROMPT_ID / GOOGLE_DOCS_GROUNDING_ID aliases)
GOOGLE_SYSTEM_PROMPT_DOCUMENT_ID=1ujFrCT7jG7PzeVcQIsunTXUDa9keuamYY-55k_lkl4
GOOGLE_GROUNDING_DOCUMENT_ID=17rH7oJj3XwwVGZMk_T5JnK-efpiKB-Vi1Z-yXf_y3Lk
GOOGLE_DOCS_CACHE_TTL_SECONDS=300

# Google Service Account Credentials — two formats are supported:
#
# LOCAL DEV: raw JSON string (wrap in single quotes to avoid shell issues)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n","client_email":"service-account@your-project-id.iam.gserviceaccount.com","client_id":"your-client-id"}
# Or set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON file path.

# PRODUCTION (Render): base64-encoded JSON — avoids newline corruption in platform env vars.
# Generate with: python -c "import base64; print(base64.b64encode(open('sa.json').read().encode()).decode())"
# GOOGLE_SERVICE_ACCOUNT_JSON_B64=<base64-encoded-json-here>
# Google OAuth (Web application client; separate from the Docs service account)
# Register this exact callback in Google Cloud's OAuth client settings.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Verification and password-reset emails. TLS is mandatory (STARTTLS 587 or SSL 465).
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Resend HTTPS email delivery (preferred on Render Free).
# Store the real API key only in deployment secrets or Git-ignored .env.
RESEND_API_KEY=
# Without a verified domain, this sender can email only your Resend account address.
RESEND_FROM="Odin <onboarding@resend.dev>"

# Google Sheets persona registry (use Sheet1!A2:F if the tab is not renamed)
GOOGLE_PERSONAS_SHEET_ID=1E2qwGqS6gM2retCLoGSVtvFcSOXodKR4_RQK7EwkOEM
GOOGLE_PERSONAS_SHEET_RANGE=Personas!A2:F
GOOGLE_PERSONAS_CACHE_TTL_SECONDS=300
