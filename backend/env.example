# Copy to backend/.env; keep real values out of Git.
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
DATABASE_URL=postgresql://user:password@localhost:5432/advisor_db

# OpenRouter; costs are estimates per million tokens, not live pricing.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=Advisor Console
OPENROUTER_PROMPT_COST_PER_1M=0.15
OPENROUTER_COMPLETION_COST_PER_1M=0.60
MAX_COMPLETION_TOKENS=1024
MAX_HISTORY_MESSAGES=50
MAX_HISTORY_SUMMARY_CHARS=6000

# Initial persisted quota/rate defaults; admin dashboard changes override these.
MAX_MESSAGES_PER_DAY=50
MAX_TOKENS_PER_DAY=50000
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Legacy Odin Docs: replace with your own IDs, or omit to use built-in project IDs.
GOOGLE_DOCS_PROMPT_ID=your-odin-prompt-document-id
GOOGLE_DOCS_GROUNDING_ID=your-grounding-document-id
# Canonical overrides take precedence over legacy aliases when set:
# GOOGLE_SYSTEM_PROMPT_DOCUMENT_ID=your-odin-prompt-document-id
# GOOGLE_GROUNDING_DOCUMENT_ID=your-grounding-document-id
GOOGLE_DOCS_CACHE_TTL_SECONDS=300

# Omit SHEET_ID to use the built-in master registry ID.
GOOGLE_PERSONAS_SHEET_ID=your-persona-spreadsheet-id
# Use Sheet1!A2:F if the tab has not been renamed.
GOOGLE_PERSONAS_SHEET_RANGE=Personas!A2:F
GOOGLE_PERSONAS_CACHE_TTL_SECONDS=300

# Set one format using your service-account JSON; B64 takes precedence.
# Leave empty until configured. GOOGLE_APPLICATION_CREDENTIALS is not supported.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# Optional Google login; separate Web OAuth client, not the service account.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Optional recovery/verification email. Current transport is SMTP only.
# 587 uses STARTTLS, 465 uses implicit TLS. Signup/login do not require email.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
